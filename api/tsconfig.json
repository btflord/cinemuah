{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "typeRoots": [
      "../node_modules/@types"
    ],
    "types": [
      "node"
    ],
    "lib": [
      "ES2022",
      "DOM"
    ],
    "esModuleInterop": true
  },
  "include": [
    "./*.ts"
  ]
}
