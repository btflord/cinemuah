{
  "name": "cinemuah",
  "version": "2.0.0",
  "description": "Cinemuah: a cassette-shelf desktop movie & series player for your local library and online catalogues",
  "main": "dist-electron/electron/main.js",
  "homepage": "./",
  "author": "btflord",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && tsc -p tsconfig.electron.json && electron .",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "build:electron": "npm run build && electron-builder",
    "start": "electron .",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "package:mac": "npm run build && electron-builder --mac --arm64"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "cors": "^2.8.6",
    "express": "^4.18.3",
    "ffmpeg-static": "^5.3.0",
    "mime": "^3.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sql.js": "^1.12.0",
    "webtorrent": "2.5.19"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^29.4.6",
    "electron-builder": "^24.9.4",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.cinelocal.app",
    "productName": "CineLocal",
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!dist-electron/**/*.sqlite",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/cinelocal.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "asar": false,
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "public/icon.png",
      "category": "public.app-category.entertainment",
      "identity": null
    },
    "artifactName": "Cinemuah-${version}-mac-${arch}.${ext}"
  },
  "overrides": {
    "uint8-util": "2.2.5"
  }
}
